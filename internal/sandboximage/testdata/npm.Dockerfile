# syntax=docker/dockerfile:1
# Factory sandbox for `smelt factory build --backend docker`.
# Generated by `smelt init`; edit freely, smelt will not overwrite it.
# The repo is bind-mounted at run time, so this image holds tools, not source.
FROM cimg/node:22.12
ENV PATH=/home/circleci/.local/bin:$PATH

# --- dependencies: rebuilt when these files change -------------------------
COPY --chown=circleci package-lock.json package.json /tmp/smelt-deps/
RUN cd /tmp/smelt-deps && npm ci --ignore-scripts && rm -rf /tmp/smelt-deps

# --- smelt agent kit -------------------------------------------------------
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      git coreutils procps ca-certificates curl bash \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system safe.directory '*'
USER circleci
RUN curl -fsSL https://claude.ai/install.sh | bash && test -x "$HOME/.local/bin/claude"
CMD ["sleep", "infinity"]
