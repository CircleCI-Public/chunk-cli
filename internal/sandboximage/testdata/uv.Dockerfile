# syntax=docker/dockerfile:1
# Factory sandbox for `chunk factory build --backend docker`.
# Generated by `chunk init`; edit freely, chunk will not overwrite it.
# The repo is bind-mounted at run time, so this image holds tools, not source.
FROM python:3.12
ENV UV_CACHE_DIR=/root/.cache/uv
ENV UV_LINK_MODE=copy
ENV PATH=/root/.local/bin:$PATH

# --- dependencies: rebuilt when these files change -------------------------
COPY pyproject.toml uv.lock /tmp/chunk-deps/
RUN cd /tmp/chunk-deps && uv sync --frozen --no-install-project && rm -rf /tmp/chunk-deps

# --- chunk agent kit -------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      git coreutils procps ca-certificates curl bash \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system safe.directory '*'
RUN curl -fsSL https://claude.ai/install.sh | bash && test -x "$HOME/.local/bin/claude"
CMD ["sleep", "infinity"]
