# syntax=docker/dockerfile:1
# Factory sandbox for `smelt factory build --backend docker`.
# Generated by `smelt init`; edit freely, smelt will not overwrite it.
# The repo is bind-mounted at run time, so this image holds tools, not source.
FROM cimg/rust:1.80
ENV PATH=/home/circleci/.local/bin:$PATH

# --- dependencies: rebuilt when these files change -------------------------
COPY --chown=circleci Cargo.lock Cargo.toml /tmp/smelt-deps/
COPY --chown=circleci crates/a/Cargo.toml /tmp/smelt-deps/crates/a/
RUN cd /tmp/smelt-deps && find . -name Cargo.toml -execdir sh -c 'mkdir -p src && touch src/lib.rs' \; && cargo fetch --locked && rm -rf /tmp/smelt-deps

# --- smelt agent kit -------------------------------------------------------
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      git coreutils procps ca-certificates curl bash \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system safe.directory '*'
USER circleci
RUN curl -fsSL https://claude.ai/install.sh | bash && test -x "$HOME/.local/bin/claude"
CMD ["sleep", "infinity"]
