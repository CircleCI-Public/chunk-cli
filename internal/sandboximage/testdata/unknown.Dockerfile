# Factory sandbox for `chunk factory build --backend docker`.
# Generated by `chunk init`; edit freely, chunk will not overwrite it.
# The repo is bind-mounted at run time, so this image holds tools, not source.
FROM debian:bookworm-slim
ENV PATH=/root/.local/bin:$PATH

# --- toolchain -------------------------------------------------------------
# chunk did not recognise this repo's stack. Add its toolchain here (compilers,
# runtimes, system libraries) so the validation commands can run.

# --- chunk agent kit -------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      git coreutils procps ca-certificates curl bash \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system safe.directory '*'
RUN curl -fsSL https://claude.ai/install.sh | bash && test -x "$HOME/.local/bin/claude"
CMD ["sleep", "infinity"]
