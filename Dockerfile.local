# syntax=docker/dockerfile:1
#
# Local sandbox image for `chunk factory --backend docker`.
#
# This is the environment a factory *sidecar* runs in — the box the AI agent
# edits code on and where your tests run. Build it once, then point the factory
# at it:
#
#     docker build -t chunk-sandbox:local -f Dockerfile.local .
#     chunk factory build --backend docker --image chunk-sandbox:local "your task"
#
# It contains exactly what the loop needs:
#   - the tools the loop's own scripts run inside the sidecar (git, sha256sum,
#     base64, cut, pkill)
#   - the Claude Code CLI, which the implementer and reviewers invoke
# plus a clearly-marked slot for your project's test/lint toolchain.
#
# The repo is NOT copied in at build time — the Docker backend bind-mounts a
# fresh copy of your working tree into the container at run time. So this image
# only needs tools, never your source. (That also means no rsync/ssh here: the
# file transport is host-side.)

FROM debian:bookworm-slim

ENV HOME=/root \
    DEBIAN_FRONTEND=noninteractive \
    PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin

# Tools the factory loop itself invokes inside the sidecar:
#   git                    baseline commit, diff/collect, fingerprint
#   coreutils              sha256sum, base64, cut (fingerprint + prompt piping)
#   procps                 pkill (cancels a review that timed out)
#   ca-certificates, curl  fetch the Claude installer (and TLS for the agent)
#   bash                   a predictable shell for the loop's scripts
RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      coreutils \
      procps \
      ca-certificates \
      curl \
      bash \
    && rm -rf /var/lib/apt/lists/*

# -- Project toolchain -------------------------------------------------------
# Add whatever your repo's tests and linters need, so the validation commands
# in .chunk/config.json can run inside the sidecar. Examples (uncomment/edit):
#
# RUN apt-get update && apt-get install -y --no-install-recommends \
#       python3 python3-pip \
#       nodejs npm \
#       golang-go \
#     && rm -rf /var/lib/apt/lists/*
# ---------------------------------------------------------------------------

# Claude Code CLI. The native installer drops `claude` in $HOME/.local/bin,
# which is exactly where the factory's scripts look (they prepend it to PATH).
RUN curl -fsSL https://claude.ai/install.sh | bash \
    && test -x /root/.local/bin/claude

# The factory keeps the container alive and execs commands into it.
CMD ["sleep", "infinity"]
