+// TestScopedPromptsTellsReviewersWhatIsUnderReview covers the only thing
+// pointing a reviewer at the implementer's uncommitted work rather than at the
+// branch's commits: without it reviews still run, and report on the wrong code.
+func TestScopedPromptsTellsReviewersWhatIsUnderReview(t *testing.T) {
+	s := &Sidecars{Prompts: []review.Prompt{{Name: "correctness", Body: "look for bugs"}}}
+
+	got := s.scopedPrompts()
+
+	assert.Equal(t, len(got), 1)
+	assert.Equal(t, got[0].Name, "correctness")
+	assert.Equal(t, got[0].Body, reviewScope+"look for bugs")
+	// The same prompts are scoped again every round, so they must not be
+	// rewritten in place.
+	assert.Equal(t, s.Prompts[0].Body, "look for bugs")
+}
