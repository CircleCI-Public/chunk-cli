+// execLog records every script a sidecar was asked to run, so a test can see
+// what ran where, and in what order.
+type execLog struct {
+	mu   sync.Mutex
+	runs []execRun
+}
+
+type execRun struct {
+	sidecarID string
+	script    string
+}
+
+func (l *execLog) add(sidecarID, script string) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.runs = append(l.runs, execRun{sidecarID: sidecarID, script: script})
+}
+
+// on returns the IDs of the sidecars that ran a script containing substr, in
+// the order the scripts started.
+func (l *execLog) on(substr string) []string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	var ids []string
+	for _, r := range l.runs {
+		if strings.Contains(r.script, substr) {
+			ids = append(ids, r.sidecarID)
+		}
+	}
+	return ids
+}
+
+// fakeExec stands in for running a script on a sidecar: it records the script
+// and answers with whatever reply gives for it.
+func fakeExec(log *execLog, reply func(e *sidecar.PoolEntry, script string) (string, int)) review.Execer {
+	return func(_ context.Context, e *sidecar.PoolEntry, script string, _ map[string]string, onOutput circleci.OutputFn, _ func(string)) (int, error) {
+		out, code := reply(e, script)
+		// Recorded after reply runs, so a reply can observe the state of the
+		// world as of the moment the script started.
+		log.add(e.ID, script)
+		if out != "" {
+			onOutput(circleci.StreamStdout, []byte(out))
+		}
+		return code, nil
+	}
+}
+
+// reviewNoFindings is what claude's structured result looks like for a review
+// that found nothing.
+const reviewNoFindings = `{"is_error":false,"structured_output":{"review":"Nothing found.","findings":[]}}`
+
+// isReviewScript reports whether a script is a review rather than validation
+// or the stray-review sweep.
+func isReviewScript(script string) bool {
+	return strings.Contains(script, "claude") && !strings.Contains(script, "pkill")
+}
+
+// newCheckSidecars wires a Sidecars whose sidecars are directories on this
+// machine: the relay runs real rsync over the fake tunnel, while the scripts
+// go to reply instead of claude.
+func newCheckSidecars(t *testing.T, prompts []review.Prompt, cmds []config.Command, reviewers int,
+	reply func(e *sidecar.PoolEntry, script string) (string, int),
+) (s *Sidecars, log *execLog, implDir string) {
+	t.Helper()
+	r := newRelay(t)
+
+	implDir = gitrepo.SetupGitRepo(t, "my-org", "my-repo")
+	writeFile(t, implDir, "main.go", "package main\n")
+
+	revs := make([]*sidecar.PoolEntry, reviewers)
+	for i := range revs {
+		revs[i] = &sidecar.PoolEntry{
+			ID:       "rev-" + string(rune('1'+i)),
+			RepoPath: filepath.Join(t.TempDir(), "my-repo"),
+		}
+	}
+
+	log = &execLog{}
+	ex := fakeExec(log, reply)
+	return &Sidecars{
+		Exec:        ex,
+		Implementer: &Implementer{Exec: ex, Entry: &sidecar.PoolEntry{ID: "impl", RepoPath: implDir}},
+		Reviewers:   revs,
+		Relay:       r,
+		Prompts:     prompts,
+		Review:      review.Options{Credential: review.Credential{EnvVar: "ANTHROPIC_API_KEY", Value: "k"}, StructuredFindings: true},
+		Commands:    cmds,
+	}, log, implDir
+}
+
+// checkNames returns the names of the checks of one kind, in order.
+func checkNames(checks []Check, kind Kind) []string {
+	var names []string
+	for _, c := range checks {
+		if c.Kind == kind {
+			names = append(names, c.Name)
+		}
+	}
+	return names
+}
