+package acceptance
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"gotest.tools/v3/assert"
+
+	"github.com/CircleCI-Public/chunk-cli/internal/testing/binary"
+	testenv "github.com/CircleCI-Public/chunk-cli/internal/testing/env"
+	"github.com/CircleCI-Public/chunk-cli/internal/testing/gitrepo"
+)
+
+// TestFactoryRequiresOnePrompt covers the argument validator: the prompt is
+// one argument, so an unquoted sentence has to be rejected rather than
+// implemented as its first word.
+func TestFactoryRequiresOnePrompt(t *testing.T) {
+	env := testenv.NewTestEnv(t)
+	workDir := gitrepo.SetupGitRepo(t, "test-org", "test-repo")
+
+	for _, args := range [][]string{
+		{"factory"},
+		{"factory", "   "},
+		{"factory", "add", "a --verbose flag"},
+	} {
+		result := binary.RunCLI(t, args, env, workDir)
+
+		assert.Equal(t, result.ExitCode, 2, "args %v, stderr: %s", args, result.Stderr)
+		assert.Assert(t, strings.Contains(result.Stderr, "Pass the prompt as one argument."), "stderr: %s", result.Stderr)
+	}
+}
+
+// TestFactoryNeedsAConfiguredProject covers the run started somewhere chunk
+// knows nothing about: it must name 'chunk init' rather than fail later.
+func TestFactoryNeedsAConfiguredProject(t *testing.T) {
+	env := testenv.NewTestEnv(t)
+	workDir := gitrepo.SetupGitRepo(t, "test-org", "test-repo")
+
+	result := binary.RunCLI(t, []string{"factory", "add a --verbose flag"}, env, workDir)
+
+	assert.Assert(t, result.ExitCode != 0, "expected non-zero exit code")
+	assert.Assert(t, strings.Contains(result.Stderr, "No validate commands configured."), "stderr: %s", result.Stderr)
+	assert.Assert(t, strings.Contains(result.Stderr, "chunk init"), "stderr: %s", result.Stderr)
+}
+
+// TestFactoryRefusesToRunWithNothingToCheck guards the loop's one safeguard:
+// with no reviews and no validation commands every round would pass whatever
+// the implementer wrote. It must stop before paying for a sidecar.
+func TestFactoryRefusesToRunWithNothingToCheck(t *testing.T) {
+	env := testenv.NewTestEnv(t)
+	workDir := gitrepo.SetupGitRepo(t, "test-org", "test-repo")
+	// Configured, but with nothing the loop can run remotely and no reviews.
+	writeChunkConfig(t, workDir, map[string]interface{}{
+		"commands": []map[string]interface{}{
+			{"name": "format", "run": "gofmt -w .", "role": "autofix"},
+		},
+	})
+
+	result := binary.RunCLI(t, []string{"factory", "add a --verbose flag"}, env, workDir)
+
+	assert.Assert(t, result.ExitCode != 0, "expected non-zero exit code")
+	assert.Assert(t, strings.Contains(result.Stderr, "Nothing to check the implementer's work with."), "stderr: %s", result.Stderr)
+}
+
+// TestFactoryRejectsAMissingReviewsDirectory covers the flag whose typo would
+// otherwise be silent: reviewing nothing still reports that all checks passed.
+func TestFactoryRejectsAMissingReviewsDirectory(t *testing.T) {
+	env := testenv.NewTestEnv(t)
+	workDir := gitrepo.SetupGitRepo(t, "test-org", "test-repo")
+	writeChunkConfig(t, workDir, nil)
+	writePrompts(t, filepath.Join(workDir, ".chunk", "reviews"), "correctness")
+
+	result := binary.RunCLI(t, []string{"factory", "--reviews", ".chunk/review", "add a --verbose flag"}, env, workDir)
+
+	assert.Assert(t, result.ExitCode != 0, "expected non-zero exit code")
+	assert.Assert(t, strings.Contains(result.Stderr, "No review prompts directory at"), "stderr: %s", result.Stderr)
+}
+
+// TestFactoryHelpPinsItsFlags keeps the command's surface where the docs say
+// it is, and keeps it hidden while the workshop build settles.
+func TestFactoryHelpPinsItsFlags(t *testing.T) {
+	env := testenv.NewTestEnv(t)
+	workDir := gitrepo.SetupGitRepo(t, "test-org", "test-repo")
+
+	result := binary.RunCLI(t, []string{"factory", "--help"}, env, workDir)
+	assert.Equal(t, result.ExitCode, 0, "stderr: %s", result.Stderr)
+
+	for _, flag := range []string{
+		"--attempts int", "--reviewers int", "--reviews string", "--no-validate",
+		"--keep-sidecars", "--org-id string", "--image string", "--model string",
+		"--implement-timeout duration", "--review-timeout duration",
+	} {
+		assert.Assert(t, strings.Contains(result.Stdout, flag), "flag %s missing from: %s", flag, result.Stdout)
+	}
+	assert.Assert(t, strings.Contains(result.Stdout, "(default 3)"), "stdout: %s", result.Stdout)
+
+	root := binary.RunCLI(t, []string{"--help"}, env, workDir)
+	assert.Assert(t, !strings.Contains(root.Stdout, "factory"), "factory is still hidden: %s", root.Stdout)
+}
