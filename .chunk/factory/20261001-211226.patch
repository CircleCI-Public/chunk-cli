+// TestCheckWrapsReviewErrors covers a review pass that could not run at all:
+// the round has no reviews to report, so no half-checked result may be
+// returned as though the work had been checked.
+func TestCheckWrapsReviewErrors(t *testing.T) {
+	prompts := []review.Prompt{{Name: "correctness", Body: "look for bugs"}}
+	cmds := []config.Command{{Name: "test", Run: "go test ./..."}}
+	s, _, _ := newCheckSidecars(t, prompts, cmds, 1, func(_ *sidecar.PoolEntry, script string) (string, int) {
+		if isReviewScript(script) {
+			return "", review.ExitClaudeMissing
+		}
+		return "ok\n", 0
+	})
+
+	checks, err := s.Check(context.Background(), 1)
+	assert.Assert(t, checks == nil, "validation results were returned without the reviews")
+	assert.ErrorContains(t, err, "reviews: ")
+	assert.Assert(t, errors.Is(err, review.ErrClaudeMissing), "got %v", err)
+}
+
+// TestCheckStopsStrayReviewsBeforePushing guards the ordering: a review left
+// running by an earlier round would read the tree as rsync replaces it, so
+// every reviewer must be swept before anything is pushed to it.
+func TestCheckStopsStrayReviewsBeforePushing(t *testing.T) {
+	prompts := []review.Prompt{{Name: "correctness", Body: "look for bugs"}, {Name: "tests", Body: "look at the tests"}}
+	sweptBeforePush := map[string]bool{}
+	var mu sync.Mutex
+	s, log, _ := newCheckSidecars(t, prompts, nil, 2, func(e *sidecar.PoolEntry, script string) (string, int) {
+		if strings.Contains(script, "pkill") {
+			_, err := os.Stat(filepath.Join(e.RepoPath, "main.go"))
+			mu.Lock()
+			sweptBeforePush[e.ID] = os.IsNotExist(err)
+			mu.Unlock()
+			return "", 0
+		}
+		return reviewNoFindings, 0
+	})
+
+	_, err := s.Check(context.Background(), 1)
+	assert.NilError(t, err)
+
+	var swept []string
+	for _, rev := range s.Reviewers {
+		swept = append(swept, rev.ID)
+		assert.Assert(t, sweptBeforePush[rev.ID], "%s was pushed to before its stray reviews were stopped", rev.ID)
+	}
+	assert.DeepEqual(t, sorted(log.on("pkill")), sorted(swept))
+}
+
+// sorted copies ids in order, so an assertion does not depend on which
+// goroutine got there first.
+func sorted(ids []string) []string {
+	out := append([]string(nil), ids...)
+	slices.Sort(out)
+	return out
+}
