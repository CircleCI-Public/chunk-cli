+// TestWritePatchProducesAnApplyablePatch covers the run's only durable output.
+// A patch that does not apply loses everything the implementer did, and
+// nothing else in the run would notice.
+func TestWritePatchProducesAnApplyablePatch(t *testing.T) {
+	r := newRelay(t)
+	ctx := context.Background()
+
+	impl := gitrepo.SetupGitRepo(t, "my-org", "my-repo")
+	writeFile(t, impl, ".gitignore", "build/\n")
+	writeFile(t, impl, "main.go", "package main\n")
+	writeFile(t, impl, "doomed.go", "package main\n")
+	gitrepo.AddFile(t, impl, ".")
+	gitOutput(t, impl, "commit", "-m", "baseline")
+
+	// What the implementer leaves behind: an edit, a new text file, a new
+	// binary file, a deletion, and build output no patch should carry.
+	writeFile(t, impl, "main.go", "package main\n\nfunc main() {}\n")
+	writeFile(t, impl, "pkg/new.go", "package pkg\n")
+	assert.NilError(t, os.WriteFile(filepath.Join(impl, "logo.png"), []byte{0x89, 'P', 'N', 'G', 0x00, 0x1a}, 0o644))
+	assert.NilError(t, os.Remove(filepath.Join(impl, "doomed.go")))
+	writeFile(t, impl, "build/app", "binary")
+	// collect marks new files intent-to-add so git diff HEAD shows them.
+	gitOutput(t, impl, "add", "-A", "-N")
+
+	s := &Sidecars{Relay: r, Implementer: &Implementer{Entry: &sidecar.PoolEntry{ID: "impl", RepoPath: impl}}}
+	path := filepath.Join(t.TempDir(), "chunk", "factory", "20240101-000000.patch")
+	assert.NilError(t, s.WritePatch(ctx, path))
+
+	// The developer's tree is the baseline the run started from.
+	dev := filepath.Join(t.TempDir(), "my-repo")
+	gitOutput(t, impl, "clone", "--quiet", impl, dev)
+	gitOutput(t, dev, "apply", path)
+
+	assert.Equal(t, readFile(t, dev, "main.go"), "package main\n\nfunc main() {}\n")
+	assert.Equal(t, readFile(t, dev, "pkg/new.go"), "package pkg\n")
+	assert.Equal(t, readFile(t, dev, "logo.png"), string([]byte{0x89, 'P', 'N', 'G', 0x00, 0x1a}))
+	_, err := os.Stat(filepath.Join(dev, "doomed.go"))
+	assert.Assert(t, os.IsNotExist(err), "the deletion did not survive the patch")
+	_, err = os.Stat(filepath.Join(dev, "build"))
+	assert.Assert(t, os.IsNotExist(err), "ignored build output was carried into the patch")
+
+	// The ignored build output stays on the sidecar, so it is not part of the
+	// tree the patch has to reproduce.
+	want := treeOf(t, impl)
+	delete(want, filepath.Join("build", "app"))
+	assert.DeepEqual(t, treeOf(t, dev), want)
+}
+
+// TestWritePatchReportsNoWork covers the implementer that changed nothing: an
+// empty patch file on disk reads as work lost.
+func TestWritePatchReportsNoWork(t *testing.T) {
+	r := newRelay(t)
+
+	impl := gitrepo.SetupGitRepo(t, "my-org", "my-repo")
+	writeFile(t, impl, "main.go", "package main\n")
+	gitrepo.AddFile(t, impl, ".")
+	gitOutput(t, impl, "commit", "-m", "baseline")
+
+	s := &Sidecars{Relay: r, Implementer: &Implementer{Entry: &sidecar.PoolEntry{ID: "impl", RepoPath: impl}}}
+	path := filepath.Join(t.TempDir(), "work.patch")
+	err := s.WritePatch(context.Background(), path)
+
+	assert.Assert(t, errors.Is(err, ErrNoWork), "got %v", err)
+	_, statErr := os.Stat(path)
+	assert.Assert(t, os.IsNotExist(statErr), "an empty patch was written")
+}
