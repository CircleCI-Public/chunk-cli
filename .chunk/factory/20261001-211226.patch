+func TestCheckRunsReviewsAndValidationTogether(t *testing.T) {
+	prompts := []review.Prompt{{Name: "correctness", Body: "look for bugs"}, {Name: "tests", Body: "look at the tests"}}
+	cmds := []config.Command{{Name: "test", Run: "go test ./..."}, {Name: "lint", Run: "golangci-lint run"}}
+	var done []Check
+	s, log, _ := newCheckSidecars(t, prompts, cmds, 2, func(_ *sidecar.PoolEntry, script string) (string, int) {
+		if isReviewScript(script) {
+			return reviewNoFindings, 0
+		}
+		return "ok\n", 0
+	})
+	s.OnCheck = func(c Check) { done = append(done, c) }
+
+	checks, err := s.Check(context.Background(), 1)
+	assert.NilError(t, err)
+
+	assert.DeepEqual(t, checkNames(checks, KindReview), []string{"correctness", "tests"})
+	assert.DeepEqual(t, checkNames(checks, KindValidate), []string{"test", "lint"})
+	assert.Assert(t, Passed(checks))
+	// OnCheck reports validation only; reviews report through Review.ProgressFn.
+	assert.DeepEqual(t, checkNames(done, KindValidate), []string{"test", "lint"})
+	assert.Equal(t, len(checkNames(done, KindReview)), 0)
+
+	// Every reviewer must hold the implementer's tree, and validation must have
+	// run on the implementer rather than on a reviewer.
+	for _, rev := range s.Reviewers {
+		assert.Equal(t, readFile(t, rev.RepoPath, "main.go"), "package main\n")
+	}
+	assert.DeepEqual(t, log.on("go test ./..."), []string{"impl"})
+}
