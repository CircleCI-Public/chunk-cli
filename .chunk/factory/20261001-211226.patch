+// newProvisionClient returns a client for a fake CircleCI, with HOME pointed at
+// a temp directory so key generation stays out of the developer's ~/.ssh.
+func newProvisionClient(t *testing.T) (*circleci.Client, *fakes.FakeCircleCI) {
+	t.Helper()
+	t.Setenv(config.EnvHome, t.TempDir())
+
+	cci := fakes.NewFakeCircleCI()
+	api := httptest.NewServer(cci)
+	t.Cleanup(api.Close)
+
+	client, err := circleci.NewClient(circleci.Config{Token: "fake-token", BaseURL: api.URL})
+	assert.NilError(t, err)
+	return client, cci
+}
+
+func noStatus(iostream.Level, string) {}
+
+// TestProvisionDeletesSidecarsItCreatedWhenOneFails guards the error path:
+// sidecars are billed for, so a run that cannot provision its whole set must
+// leave none of them behind.
+func TestProvisionDeletesSidecarsItCreatedWhenOneFails(t *testing.T) {
+	client, cci := newProvisionClient(t)
+	cci.CreateErrorAfter = 2
+
+	impl, revs, err := Provision(context.Background(), client, "org-1", "ubuntu:22.04", "/home/user/my-repo", 3, noStatus)
+
+	assert.Assert(t, err != nil, "provision should fail when a sidecar cannot be created")
+	assert.ErrorContains(t, err, "create factory-")
+	assert.Assert(t, impl == nil)
+	assert.Assert(t, revs == nil)
+	assert.Equal(t, len(cci.Sidecars), 0, "sidecars were left running after a failed provision")
+	assert.Equal(t, countDeletes(cci), 2, "every sidecar created should be deleted")
+}
+
+// TestProvisionWaitsOutAddKeyNotFound covers the lag between a sidecar being
+// created and the provisioner accepting a key for it: a 404 there is transient
+// and must not fail the run.
+func TestProvisionWaitsOutAddKeyNotFound(t *testing.T) {
+	client, cci := newProvisionClient(t)
+	// Only the implementer is created, so its ID is known up front.
+	cci.NotFoundBeforeAddKey = map[string]int{"sidecar-new-1": 1}
+
+	impl, revs, err := Provision(context.Background(), client, "org-1", "ubuntu:22.04", "/home/user/my-repo", 0, noStatus)
+
+	assert.NilError(t, err)
+	assert.Equal(t, impl.ID, "sidecar-new-1")
+	assert.Equal(t, len(revs), 0)
+	assert.Equal(t, countDeletes(cci), 0)
+}
+
+// TestProvisionNamesSidecarsForTheirRole pins the split between the
+// implementer and the reviewers, which is positional and otherwise silent.
+func TestProvisionNamesSidecarsForTheirRole(t *testing.T) {
+	client, cci := newProvisionClient(t)
+
+	impl, revs, err := Provision(context.Background(), client, "org-1", "ubuntu:22.04", "/home/user/my-repo", 2, noStatus)
+	assert.NilError(t, err)
+
+	byID := map[string]string{}
+	for _, sc := range cci.Sidecars {
+		byID[sc.ID] = sc.Name
+		assert.Equal(t, sc.OrgID, "org-1")
+		assert.Equal(t, sc.Image, "ubuntu:22.04")
+	}
+	assert.Equal(t, byID[impl.ID], "factory-implementer")
+	assert.Equal(t, impl.RepoPath, "/home/user/my-repo")
+
+	var names []string
+	for _, r := range revs {
+		names = append(names, byID[r.ID])
+		assert.Equal(t, r.RepoPath, "/home/user/my-repo")
+	}
+	assert.DeepEqual(t, sorted(names), []string{"factory-reviewer-1", "factory-reviewer-2"})
+}
+
+func countDeletes(cci *fakes.FakeCircleCI) int {
+	n := 0
+	for _, r := range cci.Recorder.AllRequests() {
+		if r.Method == "DELETE" {
+			n++
+		}
+	}
+	return n
+}
