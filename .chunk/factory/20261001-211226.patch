index 79306fe5..e66bc423 100644
--- a/internal/factory/implementer_test.go
+++ b/internal/factory/implementer_test.go
@@ -197,3 +197,40 @@ func TestStreamParserDropsOversizedLines(t *testing.T) {
 	assert.Assert(t, p.sawResult)
 	assert.Assert(t, len(p.buf) < maxLineBytes)
 }
+
+// TestImplementerResumesAfterAFailedFirstTurn covers the retry claude has
+// already created a session for: the turn failed, but the session exists, so
+// the next turn must resume it. Passing --session-id again would be rejected
+// as a duplicate, and every retry after a failed first turn would die.
+func TestImplementerResumesAfterAFailedFirstTurn(t *testing.T) {
+	firstTurnFails := `if [ "$(grep -c -- '--end--' "$HOME/args")" -eq 1 ]; then
+ printf '%s\n' '{"type":"system","subtype":"init","session_id":"s"}'
+ exit 1
+fi
+` + streamOK
+	im, home, _ := newImplementer(t, firstTurnFails)
+
+	_, err := im.Run(context.Background(), "first")
+	assert.ErrorContains(t, err, "implementer exited 1")
+	_, err = im.Run(context.Background(), "try again")
+	assert.NilError(t, err)
+
+	args, err := os.ReadFile(filepath.Join(home, "args"))
+	assert.NilError(t, err)
+	lines := strings.Split(strings.TrimSuffix(string(args), "--end--\n"), "--end--\n")
+	assert.Equal(t, len(lines), 2)
+	assert.Assert(t, strings.Contains(lines[0], "--session-id "+im.sessionID), lines[0])
+	assert.Assert(t, strings.Contains(lines[1], "--resume "+im.sessionID), lines[1])
+}
+
+// TestImplementerTimesOut covers the turn that runs past its deadline: the
+// work it did is on the sidecar, and the error has to say why it stopped
+// rather than report the kill as an exec failure.
+func TestImplementerTimesOut(t *testing.T) {
+	im, _, _ := newImplementer(t, "sleep 30")
+	im.Timeout = 50 * time.Millisecond
+
+	_, err := im.Run(context.Background(), "take your time")
+
+	assert.ErrorContains(t, err, "implementer timed out after 50ms")
+}
