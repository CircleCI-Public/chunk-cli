+// TestCheckSkipsRelayPushWhenNoPrompts covers the guard that keeps a run with
+// no review prompts from paying for a push to reviewers nothing will read.
+func TestCheckSkipsRelayPushWhenNoPrompts(t *testing.T) {
+	cmds := []config.Command{{Name: "test", Run: "go test ./..."}}
+	s, log, _ := newCheckSidecars(t, nil, cmds, 2, func(_ *sidecar.PoolEntry, _ string) (string, int) {
+		return "ok\n", 0
+	})
+
+	checks, err := s.Check(context.Background(), 1)
+	assert.NilError(t, err)
+
+	assert.DeepEqual(t, checkNames(checks, KindValidate), []string{"test"})
+	assert.Equal(t, len(checkNames(checks, KindReview)), 0)
+	assert.Equal(t, len(log.on("pkill")), 0, "stray reviews were swept with no reviews to run")
+	for _, rev := range s.Reviewers {
+		_, err := os.Stat(rev.RepoPath)
+		assert.Assert(t, os.IsNotExist(err), "%s was pushed to with no prompts to review", rev.ID)
+	}
+}
