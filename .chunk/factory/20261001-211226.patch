diff --git a/internal/cmd/factory_test.go b/internal/cmd/factory_test.go
new file mode 100644
index 00000000..a43fab91
--- /dev/null
+++ b/internal/cmd/factory_test.go
@@ -0,0 +1,188 @@
+package cmd
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"gotest.tools/v3/assert"
+
+	"github.com/CircleCI-Public/chunk-cli/internal/config"
+	"github.com/CircleCI-Public/chunk-cli/internal/factory"
+	"github.com/CircleCI-Public/chunk-cli/internal/iostream"
+	"github.com/CircleCI-Public/chunk-cli/internal/review"
+)
+
+// writeReviewPrompts puts one prompt file per name in dir and returns dir.
+func writeReviewPrompts(t *testing.T, dir string, names ...string) string {
+	t.Helper()
+	assert.NilError(t, os.MkdirAll(dir, 0o755))
+	for _, n := range names {
+		assert.NilError(t, os.WriteFile(filepath.Join(dir, n+".md"), []byte("review for "+n), 0o644))
+	}
+	return dir
+}
+
+// promptNames is what factoryChecks loaded, for comparison.
+func promptNames(prompts []review.Prompt) []string {
+	var names []string
+	for _, p := range prompts {
+		names = append(names, p.Name)
+	}
+	return names
+}
+
+// loadedCommandNames is what factoryChecks kept of the project's commands.
+func loadedCommandNames(cmds []config.Command) []string {
+	var names []string
+	for _, c := range cmds {
+		names = append(names, c.Name)
+	}
+	return names
+}
+
+// TestFactoryChecksDecidesWhatTheWorkIsCheckedWith covers the guard rail: with
+// neither reviews nor validation the loop would pass whatever the implementer
+// wrote, so the run has to stop before it creates a sidecar.
+func TestFactoryChecksDecidesWhatTheWorkIsCheckedWith(t *testing.T) {
+	gate := []config.Command{{Name: "test", Run: "go test ./..."}}
+
+	t.Run("nothing to check with", func(t *testing.T) {
+		_, _, err := factoryChecks(t.TempDir(), "", &config.ProjectConfig{}, false)
+		assertUserError(t, err, "Nothing to check the implementer's work with.")
+	})
+
+	t.Run("no reviews directory but commands configured", func(t *testing.T) {
+		prompts, cmds, err := factoryChecks(t.TempDir(), "", &config.ProjectConfig{Commands: gate}, false)
+		assert.NilError(t, err)
+		assert.Equal(t, len(prompts), 0)
+		assert.DeepEqual(t, loadedCommandNames(cmds), []string{"test"})
+	})
+
+	t.Run("no-validate leaves the reviews", func(t *testing.T) {
+		workDir := t.TempDir()
+		writeReviewPrompts(t, filepath.Join(workDir, review.DefaultDir), "correctness", "tests")
+
+		prompts, cmds, err := factoryChecks(workDir, "", &config.ProjectConfig{Commands: gate}, true)
+		assert.NilError(t, err)
+		assert.DeepEqual(t, promptNames(prompts), []string{"correctness", "tests"})
+		assert.Equal(t, len(cmds), 0)
+	})
+
+	// Every configured command is one the loop cannot run remotely, so the run
+	// is checked by nothing even though the project has commands.
+	t.Run("no command survives filtering", func(t *testing.T) {
+		cfg := &config.ProjectConfig{Commands: []config.Command{
+			{Name: "format", Run: "gofmt -w .", Role: "autofix"},
+			{Name: "local-only", Run: "make thing", Local: true},
+			{Name: "test-changed", Run: "go test {{CHANGED_PACKAGES}}"},
+		}}
+		_, _, err := factoryChecks(t.TempDir(), "", cfg, false)
+		assertUserError(t, err, "Nothing to check the implementer's work with.")
+	})
+
+	// A directory the user named is a claim that reviews exist there. Reading
+	// a path that is not there as "no reviews" would run on validation alone
+	// and still report that all checks passed.
+	t.Run("named reviews directory is missing", func(t *testing.T) {
+		workDir := t.TempDir()
+		writeReviewPrompts(t, filepath.Join(workDir, ".chunk", "reviews"), "correctness")
+		missing := filepath.Join(workDir, ".chunk", "review")
+
+		_, _, err := factoryChecks(workDir, missing, &config.ProjectConfig{Commands: gate}, false)
+		assertUserError(t, err, "No review prompts directory at "+missing+".")
+	})
+
+	t.Run("named reviews directory is used", func(t *testing.T) {
+		workDir := t.TempDir()
+		dir := writeReviewPrompts(t, filepath.Join(workDir, "prompts"), "security")
+
+		prompts, _, err := factoryChecks(workDir, dir, &config.ProjectConfig{Commands: gate}, false)
+		assert.NilError(t, err)
+		assert.DeepEqual(t, promptNames(prompts), []string{"security"})
+	})
+
+	// A directory that is there but cannot be read is a broken project, not a
+	// project without reviews: it must be reported rather than skipped.
+	t.Run("reviews directory cannot be read", func(t *testing.T) {
+		if os.Geteuid() == 0 {
+			t.Skip("root ignores directory permissions, so the denial cannot be staged")
+		}
+		workDir := t.TempDir()
+		dir := writeReviewPrompts(t, filepath.Join(workDir, review.DefaultDir), "correctness")
+		assert.NilError(t, os.Chmod(dir, 0o000))
+		t.Cleanup(func() { _ = os.Chmod(dir, 0o700) })
+
+		_, _, err := factoryChecks(workDir, "", &config.ProjectConfig{Commands: gate}, false)
+		assertUserError(t, err, "Could not read review prompts from "+dir+".")
+	})
+}
+
+func assertUserError(t *testing.T, err error, msg string) {
+	t.Helper()
+	var uerr *userError
+	assert.Assert(t, errors.As(err, &uerr), "want a userError, got %v", err)
+	assert.Equal(t, uerr.msg, msg)
+}
+
+// TestReportOutcomeExitsNonZeroUnlessEverythingPassed pins what a factory run
+// tells a script that called it. Only a passing run may exit 0: a CI job that
+// read an exhausted run as a success would merge code the checks still fail.
+func TestReportOutcomeExitsNonZeroUnlessEverythingPassed(t *testing.T) {
+	cases := []struct {
+		result factory.Result
+		errMsg string
+	}{
+		{factory.ResultPassed, ""},
+		{factory.ResultNoChange, "no changes"},
+		{factory.ResultStuck, "stuck"},
+		{factory.ResultExhausted, "attempts exhausted"},
+	}
+	for _, tc := range cases {
+		t.Run(string(tc.result), func(t *testing.T) {
+			err := reportOutcome(func(iostream.Level, string) {}, factory.Outcome{Result: tc.result, Rounds: 3})
+			if tc.errMsg == "" {
+				assert.NilError(t, err)
+				return
+			}
+			var uerr *userError
+			assert.Assert(t, errors.As(err, &uerr), "want a userError, got %v", err)
+			assert.Equal(t, uerr.errMsg, tc.errMsg)
+		})
+	}
+}
+
+// TestReportOutcomePrintsEveryFinding covers the only place a review's
+// findings are shown: the loop keeps them as data, so a run that ends with
+// findings would otherwise say a review failed without saying why.
+func TestReportOutcomePrintsEveryFinding(t *testing.T) {
+	var lines []string
+	status := func(_ iostream.Level, msg string) { lines = append(lines, msg) }
+	outcome := factory.Outcome{
+		Result: factory.ResultExhausted,
+		Rounds: 2,
+		Checks: []factory.Check{
+			{Name: "correctness", Kind: factory.KindReview, Status: factory.StatusFailed, Findings: []review.Finding{
+				{File: "a.go", Line: 3, Severity: review.SeverityHigh, Body: "nil deref on\nempty input"},
+				{File: "b.go", Severity: review.SeverityMedium, Body: "error dropped"},
+			}},
+			{Name: "tests", Kind: factory.KindReview, Status: factory.StatusPassed},
+			{Name: "style", Kind: factory.KindReview, Status: factory.StatusErrored, Error: "timed out after 15m0s"},
+			// Validation reported as it ran, so it is not repeated here.
+			{Name: "test", Kind: factory.KindValidate, Status: factory.StatusFailed, Feedback: "Exited 1."},
+		},
+	}
+
+	err := reportOutcome(status, outcome)
+
+	assert.ErrorContains(t, err, "attempts exhausted")
+	out := strings.Join(lines, "\n")
+	assert.Assert(t, strings.Contains(out, "review correctness: 2 finding(s)"), out)
+	assert.Assert(t, strings.Contains(out, "[high] a.go:3 nil deref on empty input"), out)
+	assert.Assert(t, strings.Contains(out, "[medium] b.go:0 error dropped"), out)
+	assert.Assert(t, strings.Contains(out, "review tests: no findings"), out)
+	assert.Assert(t, strings.Contains(out, "review style could not run: timed out after 15m0s"), out)
+	assert.Assert(t, !strings.Contains(out, "Exited 1."), out)
+}
