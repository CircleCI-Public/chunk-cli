+func writeLegacyPKCS8Key(t *testing.T, path string) {
+	t.Helper()
+	pub, priv, err := ed25519.GenerateKey(crand.Reader)
+	assert.NilError(t, err)
+	der, err := x509.MarshalPKCS8PrivateKey(priv)
+	assert.NilError(t, err)
+	assert.NilError(t, os.WriteFile(path, pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: der}), 0o600))
+	sshPub, err := ssh.NewPublicKey(pub)
+	assert.NilError(t, err)
+	assert.NilError(t, os.WriteFile(path+".pub", ssh.MarshalAuthorizedKey(sshPub), 0o644))
+}
+
+// TestEnsureKeyPairReplacesALegacyPKCS8Key covers the upgrade path. A key an
+// older chunk wrote is still parsed by the Go SSH client, so exec keeps
+// working while every rsync fails on it — the split that makes it hard to
+// diagnose. Leaving it in place would mean only brand-new installs were fixed.
+func TestEnsureKeyPairReplacesALegacyPKCS8Key(t *testing.T) {
+	keyPath := filepath.Join(t.TempDir(), ".ssh", "chunk_ai")
+	assert.NilError(t, os.MkdirAll(filepath.Dir(keyPath), 0o700))
+	writeLegacyPKCS8Key(t, keyPath)
+	oldPub, err := os.ReadFile(keyPath + ".pub")
+	assert.NilError(t, err)
+
+	generated, err := EnsureKeyPair(keyPath)
+	assert.NilError(t, err)
+
+	assert.Assert(t, generated, "a key chunk cannot sync with should be replaced")
+	assertKeyPairMatches(t, keyPath)
+	assertNoStrayFiles(t, keyPath)
+	newPub, err := os.ReadFile(keyPath + ".pub")
+	assert.NilError(t, err)
+	assert.Assert(t, !bytes.Equal(oldPub, newPub), "the public half was left behind")
+}
+
