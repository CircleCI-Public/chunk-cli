+func TestPrintEvent(t *testing.T) {
+	const attempts = 3
+
+	tests := []struct {
+		name      string
+		event     factory.Event
+		wantLines []statusLine
+	}{
+		{
+			name:      "the first round is not numbered",
+			event:     factory.Event{Kind: factory.EventImplementing, Round: 1},
+			wantLines: []statusLine{{Level: iostream.LevelStep, Msg: "Implementing..."}},
+		},
+		{
+			name:      "a later round says it is fixing failures",
+			event:     factory.Event{Kind: factory.EventImplementing, Round: 2},
+			wantLines: []statusLine{{Level: iostream.LevelStep, Msg: "Round 2/3: fixing failed checks..."}},
+		},
+		{
+			name:  "a finished turn reports its cost and summary",
+			event: factory.Event{Kind: factory.EventImplemented, Turn: factory.Turn{Summary: "added\na test", Duration: 2 * time.Second, CostUSD: 0.5}},
+			wantLines: []statusLine{
+				{Level: iostream.LevelDone, Msg: "implementer finished in 2s ($0.50)"},
+				{Level: iostream.LevelInfo, Msg: "added a test"},
+			},
+		},
+		{
+			name:  "a turn with no summary reports only the cost",
+			event: factory.Event{Kind: factory.EventImplemented, Turn: factory.Turn{Duration: time.Second}},
+			wantLines: []statusLine{
+				{Level: iostream.LevelDone, Msg: "implementer finished in 1s ($0.00)"},
+			},
+		},
+		{
+			name:      "collecting nothing warns",
+			event:     factory.Event{Kind: factory.EventCollected},
+			wantLines: []statusLine{{Level: iostream.LevelWarn, Msg: "no changes"}},
+		},
+		{
+			name:      "a collected change is reported by its stat",
+			event:     factory.Event{Kind: factory.EventCollected, Change: factory.Change{Stat: "2 files changed, \x1b[32m40 insertions(+)\x1b[0m"}},
+			wantLines: []statusLine{{Level: iostream.LevelInfo, Msg: "2 files changed, 40 insertions(+)"}},
+		},
+		{
+			name:      "checking names the round",
+			event:     factory.Event{Kind: factory.EventChecking, Round: 2},
+			wantLines: []statusLine{{Level: iostream.LevelStep, Msg: "Round 2/3: reviewing and validating..."}},
+		},
+		{
+			// Only passed counts towards the tally; errored checks say nothing
+			// about the code and must not be counted as if they did.
+			name: "checked counts the passed checks",
+			event: factory.Event{Kind: factory.EventChecked, Checks: []factory.Check{
+				{Name: "test", Status: factory.StatusPassed},
+				{Name: "lint", Status: factory.StatusFailed},
+				{Name: "bugs", Status: factory.StatusErrored},
+			}},
+			wantLines: []statusLine{{Level: iostream.LevelInfo, Msg: "1 of 3 checks passed"}},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			status, lines := recordStatus()
+
+			printEvent(status, attempts, tt.event)
+
+			assert.DeepEqual(t, *lines, tt.wantLines)
+		})
+	}
+}
