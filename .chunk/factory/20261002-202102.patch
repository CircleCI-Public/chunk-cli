+
+	"gotest.tools/v3/assert"
+
+	"github.com/CircleCI-Public/chunk-cli/internal/config"
+	"github.com/CircleCI-Public/chunk-cli/internal/factory"
+	"github.com/CircleCI-Public/chunk-cli/internal/iostream"
+	"github.com/CircleCI-Public/chunk-cli/internal/review"
+)
+
+func TestOneLineSummary(t *testing.T) {
+	tests := []struct {
+		name string
+		in   string
+		want string
+	}{
+		{
+			name: "empty",
+			in:   "",
+			want: "",
+		},
+		{
+			name: "collapses whitespace to one line",
+			in:   "  first line\n\tsecond   line  ",
+			want: "first line second line",
+		},
+		{
+			name: "short ascii is unchanged",
+			in:   "a short summary",
+			want: "a short summary",
+		},
+		{
+			name: "exactly 160 ascii characters is unchanged",
+			in:   strings.Repeat("a", 160),
+			want: strings.Repeat("a", 160),
+		},
+		{
+			name: "161 ascii characters is truncated",
+			in:   strings.Repeat("a", 161),
+			want: strings.Repeat("a", 157) + "...",
+		},
+		{
+			name: "exactly 160 multi-byte characters is unchanged",
+			in:   strings.Repeat("é", 160),
+			want: strings.Repeat("é", 160),
+		},
+		{
+			name: "multi-byte characters truncate on rune boundaries",
+			in:   strings.Repeat("é", 200),
+			want: strings.Repeat("é", 157) + "...",
+		},
+		{
+			name: "emoji truncate on rune boundaries",
+			in:   strings.Repeat("🙂", 200),
+			want: strings.Repeat("🙂", 157) + "...",
+		},
+		{
+			name: "mixed ascii and multi-byte truncates on rune boundaries",
+			in:   strings.Repeat("aé", 100),
+			want: strings.Repeat("aé", 78) + "a" + "...",
+		},
+		{
+			// Command output quoted by an agent carries colour sequences; they
+			// must not reach the terminal that prints the status line.
+			name: "ansi escape sequences are stripped",
+			in:   "\x1b[31mfailed\x1b[0m test output",
+			want: "failed test output",
+		},
+		{
+			name: "control characters are dropped",
+			in:   "bell\a and a null\x00 byte",
+			want: "bell and a null byte",
+		},
+		{
+			// A cleared line or a moved cursor would corrupt output printed
+			// after the status line, not just the line itself.
+			name: "cursor and erase sequences are stripped",
+			in:   "before\x1b[2K\x1b[1;1Hafter",
+			want: "beforeafter",
+		},
+		{
+			// ansi.Strip reads the byte after ESC as the sequence, so a stray
+			// ESC takes its neighbour with it rather than reaching the terminal.
+			name: "a lone escape is consumed with the byte after it",
+			in:   "lone \x1b escape",
+			want: "lone scape",
+		},
+		{
+			name: "a truncated sequence is dropped",
+			in:   "a\x1b[3",
+			want: "a",
+		},
+		{
+			name: "an OSC hyperlink keeps only its label",
+			in:   "\x1b]8;;https://example.invalid\x07label\x1b]8;;\x07",
+			want: "label",
+		},
+		{
+			// Quoted command output is bytes, not necessarily text.
+			name: "invalid utf-8 bytes are dropped",
+			in:   "bad\xff\xfe bytes",
+			want: "bad bytes",
+		},
+		{
+			// U+202E would reverse the rest of the line, including the
+			// file:line prefix reportOutcome puts in front of a finding.
+			name: "a right-to-left override is dropped",
+			in:   "internal/cmd/a\u202eb.go",
+			want: "internal/cmd/ab.go",
+		},
+		{
+			// An unclosed isolate would carry direction into later output, and
+			// a zero-width space hides a word boundary.
+			name: "bidi isolates and zero-width spaces are dropped",
+			in:   "x\u2066y\u200bz\u2069w",
+			want: "xyzw",
+		},
+		{
+			// The joiner is the one format character that shows as part of
+			// what it joins, so dropping it would split emoji into pieces.
+			name: "a zero width joiner is kept so emoji stay whole",
+			in:   "🙂\u200d🙂",
+			want: "🙂\u200d🙂",
+		},
+		{
+			name: "stripping happens before the limit is measured",
+			in:   "\x1b[31m" + strings.Repeat("a", 160) + "\x1b[0m",
+			want: strings.Repeat("a", 160),
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := oneLineSummary(tt.in)
+			assert.Equal(t, got, tt.want)
+			assert.Assert(t, utf8.ValidString(got), "result is not valid UTF-8: %q", got)
+			assert.Assert(t, utf8.RuneCountInString(got) <= 160, "result is %d runes, want <= 160", utf8.RuneCountInString(got))
+			assert.Assert(t, !strings.ContainsRune(got, '\x1b'), "result still carries an escape: %q", got)
+		})
+	}
+}
+
+// statusLine is one message reportOutcome reported, with the level it chose.
+type statusLine struct {
+	Level iostream.Level
+	Msg   string
+}
+
+// recordStatus returns a status func that collects what it is told, and the
+// slice it collects into.
+func recordStatus() (iostream.StatusFunc, *[]statusLine) {
+	var lines []statusLine
+	return func(level iostream.Level, msg string) {
+		lines = append(lines, statusLine{Level: level, Msg: msg})
+	}, &lines
+}
+
+func TestReportOutcome(t *testing.T) {
+	// A finding body spanning several lines must reach the status line as one
+	// line, which is what oneLineSummary is there for.
+	multiLine := review.Finding{File: "internal/cmd/factory.go", Line: 12, Severity: "high", Body: "first line\n\nsecond   line"}
+	second := review.Finding{File: "internal/cmd/root.go", Line: 3, Severity: "medium", Body: "another finding"}
+	// A review that found only minor things passes but keeps them, so what
+	// the user is told about them is decided here rather than by the loop.
+	minor := factory.FromReview(review.Result{Prompt: "style", Parsed: review.Parsed{Findings: []review.Finding{
+		{File: "a.go", Line: 4, Severity: review.SeverityLow, Body: "naming"},
+		{File: "b.go", Severity: review.SeverityInfo, Body: "nit"},
+	}}})
+
+	tests := []struct {
+		name      string
+		outcome   factory.Outcome
+		wantLines []statusLine
+		// wantErrMsg is the userError's errMsg; empty means no error.
+		wantErrMsg  string
+		wantUserErr string
+	}{
+		{
+			name:    "passed",
+			outcome: factory.Outcome{Result: factory.ResultPassed, Rounds: 2},
+			wantLines: []statusLine{
+				{Level: iostream.LevelDone, Msg: "All checks passed after 2 round(s)."},
+			},
+		},
+		{
+			name:        "no change",
+			outcome:     factory.Outcome{Result: factory.ResultNoChange, Rounds: 1},
+			wantErrMsg:  "no changes",
+			wantUserErr: "The implementer made no changes.",
+		},
+		{
+			name:        "stuck",
+			outcome:     factory.Outcome{Result: factory.ResultStuck, Rounds: 2},
+			wantErrMsg:  "stuck",
+			wantUserErr: "The implementer stopped changing the code after round 2, with checks still failing.",
+		},
+		{
+			name:        "exhausted",
+			outcome:     factory.Outcome{Result: factory.ResultExhausted, Rounds: 3},
+			wantErrMsg:  "attempts exhausted",
+			wantUserErr: "Checks still failed after 3 round(s).",
+		},
+		{
+			// An unset Result falls through the switch rather than reporting
+			// success, so a new result added upstream cannot pass by default.
+			name:        "zero value result falls through to exhausted",
+			outcome:     factory.Outcome{Rounds: 1},
+			wantErrMsg:  "attempts exhausted",
+			wantUserErr: "Checks still failed after 1 round(s).",
+		},
+		{
+			name: "failed review lists its findings on one line each",
+			outcome: factory.Outcome{
+				Result: factory.ResultExhausted,
+				Rounds: 1,
+				Checks: []factory.Check{{
+					Name:     "bugs",
+					Kind:     factory.KindReview,
+					Status:   factory.StatusFailed,
+					Findings: []review.Finding{multiLine, second},
+				}},
+			},
+			wantLines: []statusLine{
+				{Level: iostream.LevelError, Msg: "review bugs: 2 finding(s)"},
+				{Level: iostream.LevelInfo, Msg: "  [high] internal/cmd/factory.go:12 first line second line"},
+				{Level: iostream.LevelInfo, Msg: "  [medium] internal/cmd/root.go:3 another finding"},
+			},
+			wantErrMsg:  "attempts exhausted",
+			wantUserErr: "Checks still failed after 1 round(s).",
+		},
+		{
+			name: "passed review reports no findings",
+			outcome: factory.Outcome{
+				Result: factory.ResultPassed,
+				Rounds: 1,
+				Checks: []factory.Check{{Name: "bugs", Kind: factory.KindReview, Status: factory.StatusPassed}},
+			},
+			wantLines: []statusLine{
+				{Level: iostream.LevelDone, Msg: "review bugs: no findings"},
+				{Level: iostream.LevelDone, Msg: "All checks passed after 1 round(s)."},
+			},
+		},
+		{
+			name: "errored review warns with why it could not run",
+			outcome: factory.Outcome{
+				Result: factory.ResultExhausted,
+				Rounds: 1,
+				Checks: []factory.Check{{Name: "bugs", Kind: factory.KindReview, Status: factory.StatusErrored, Error: "timed out"}},
+			},
+			wantLines: []statusLine{
+				{Level: iostream.LevelWarn, Msg: "review bugs could not run: timed out"},
+			},
+			wantErrMsg:  "attempts exhausted",
+			wantUserErr: "Checks still failed after 1 round(s).",
+		},
+		{
+			name: "a passed review still lists the minor findings it kept",
+			outcome: factory.Outcome{
+				Result: factory.ResultPassed,
+				Rounds: 1,
+				Checks: []factory.Check{minor},
+			},
+			wantLines: []statusLine{
+				{Level: iostream.LevelDone, Msg: "review style: 2 minor finding(s)"},
+				{Level: iostream.LevelInfo, Msg: "  [low] a.go:4 naming"},
+				{Level: iostream.LevelInfo, Msg: "  [info] b.go nit"},
+				{Level: iostream.LevelDone, Msg: "All checks passed after 1 round(s)."},
+			},
+		},
+		{
+			// File and Severity come from the same reviewer JSON as Body, and
+			// review.cleanRepoPath does not reject escape sequences in a path.
+			name: "escape sequences in a finding's file and severity are stripped",
+			outcome: factory.Outcome{
+				Result: factory.ResultExhausted,
+				Rounds: 1,
+				Checks: []factory.Check{{
+					Name:   "bugs",
+					Kind:   factory.KindReview,
+					Status: factory.StatusFailed,
+					Findings: []review.Finding{{
