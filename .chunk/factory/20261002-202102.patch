+			name: "validation checks produce no review lines",
+			outcome: factory.Outcome{
+				Result: factory.ResultPassed,
+				Rounds: 1,
+				Checks: []factory.Check{
+					{Name: "test", Kind: factory.KindValidate, Status: factory.StatusFailed, Feedback: "FAIL"},
+					{Name: "lint", Kind: factory.KindValidate, Status: factory.StatusErrored, Error: "no sidecar"},
