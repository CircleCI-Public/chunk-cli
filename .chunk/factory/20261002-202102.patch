+func TestFactoryChecks(t *testing.T) {
+	validate := []config.Command{{Name: "test", Run: "task test"}}
+
+	tests := []struct {
+		name string
+		// setup prepares workDir and returns the reviews directory to ask for.
+		setup        func(t *testing.T, workDir string) string
+		cfg          *config.ProjectConfig
+		noValidate   bool
+		wantPrompts  []review.Prompt
+		wantCommands []config.Command
+		// wantErr is the user-facing message a userError must contain.
+		wantErr string
+	}{
+		{
+			name: "missing reviews directory leaves the validation commands",
+			setup: func(_ *testing.T, workDir string) string {
+				return filepath.Join(workDir, "nowhere")
+			},
+			cfg:          &config.ProjectConfig{Commands: validate},
+			wantCommands: validate,
+		},
+		{
+			name: "reviews directory holding no prompts leaves the validation commands",
+			setup: func(t *testing.T, workDir string) string {
+				dir := filepath.Join(workDir, "reviews")
+				writePrompt(t, dir, "notes.json", `{"not":"a prompt"}`)
+				return dir
+			},
+			cfg:          &config.ProjectConfig{Commands: validate},
+			wantCommands: validate,
+		},
+		{
+			name: "reviews path that is a file is an error",
+			setup: func(t *testing.T, workDir string) string {
+				path := filepath.Join(workDir, "reviews")
+				assert.NilError(t, os.WriteFile(path, []byte("not a directory"), 0o644))
+				return path
+			},
+			cfg:     &config.ProjectConfig{Commands: validate},
+			wantErr: "Could not read review prompts from",
+		},
+		{
+			name: "prompts alone are enough when validation is skipped",
+			setup: func(t *testing.T, workDir string) string {
+				dir := filepath.Join(workDir, "reviews")
+				writePrompt(t, dir, "bugs.md", "look for bugs")
+				return dir
+			},
+			cfg:         &config.ProjectConfig{Commands: validate},
+			noValidate:  true,
+			wantPrompts: []review.Prompt{{Name: "bugs", Body: "look for bugs"}},
+		},
+		{
+			name: "default reviews directory is read from the work directory",
+			setup: func(t *testing.T, workDir string) string {
+				writePrompt(t, filepath.Join(workDir, review.DefaultDir), "bugs.md", "look for bugs")
+				return ""
+			},
+			cfg:          &config.ProjectConfig{Commands: validate},
+			wantPrompts:  []review.Prompt{{Name: "bugs", Body: "look for bugs"}},
+			wantCommands: validate,
+		},
+		{
+			name: "no prompts and no validation is an error",
+			setup: func(_ *testing.T, workDir string) string {
+				return filepath.Join(workDir, "nowhere")
+			},
+			cfg:        &config.ProjectConfig{Commands: validate},
+			noValidate: true,
+			wantErr:    "Nothing to check the implementer's work with.",
+		},
+		{
+			// Every configured command is one ValidationCommands filters out,
+			// so the run would have nothing to check the work against.
+			name: "no prompts and only unrunnable commands is an error",
+			setup: func(_ *testing.T, workDir string) string {
+				return filepath.Join(workDir, "nowhere")
+			},
+			cfg: &config.ProjectConfig{Commands: []config.Command{
+				{Name: "fmt", Run: "task fmt", Role: "autofix"},
+				{Name: "local", Run: "task local", Local: true},
+				{Name: "templated", Run: "task test -- {{.Files}}"},
+			}},
+			wantErr: "Nothing to check the implementer's work with.",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			workDir := t.TempDir()
+			reviewsDir := tt.setup(t, workDir)
+
+			prompts, commands, err := factoryChecks(workDir, reviewsDir, tt.cfg, tt.noValidate)
+
+			if tt.wantErr != "" {
+				var ue *userError
+				assert.Assert(t, errors.As(err, &ue), "error is not a userError: %v", err)
+				assert.Assert(t, strings.Contains(ue.msg, tt.wantErr), "message %q does not contain %q", ue.msg, tt.wantErr)
+				assert.Assert(t, prompts == nil)
+				assert.Assert(t, commands == nil)
+				return
+			}
+			assert.NilError(t, err)
+			assert.DeepEqual(t, prompts, tt.wantPrompts)
+			assert.DeepEqual(t, commands, tt.wantCommands)
+		})
+	}
+}
+
+// TestFactoryChecksNothingToCheckSuggestsWhereToLook pins the guidance on the
+// error that stops a run from passing whatever the implementer wrote.
+func TestFactoryChecksNothingToCheckSuggestsWhereToLook(t *testing.T) {
+	_, _, err := factoryChecks(t.TempDir(), "", &config.ProjectConfig{}, false)
+
+	var ue *userError
+	assert.Assert(t, errors.As(err, &ue), "error is not a userError: %v", err)
+	assert.Assert(t, ue.hideDetail)
+	assert.Assert(t, strings.Contains(ue.Suggestion(), review.DefaultDir), "suggestion %q does not name the reviews directory", ue.Suggestion())
+}
