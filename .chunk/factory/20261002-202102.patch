-// oneLineSummary collapses text to one line short enough for a status line.
+// findingLine renders one finding for a status line. Every field of it was
+// written by the reviewer, so every field is sanitized.
+func findingLine(f review.Finding) string {
+	loc := sanitizeText(f.File)
+	if f.Line > 0 {
+		loc = fmt.Sprintf("%s:%d", loc, f.Line)
+	}
+	return fmt.Sprintf("  [%s] %s %s", sanitizeText(f.Severity), loc, oneLineSummary(f.Body))
+}
+
+// sanitizeText makes text written by an agent, or quoted from a command it
+// ran, safe to print in a status line: escape sequences and characters that do
+// not show as themselves are dropped, and whitespace is collapsed so one
+// message stays on one line. It does not shorten the text; oneLineSummary
+// does that.
+func sanitizeText(s string) string {
+	return strings.Join(strings.Fields(strings.Map(dropUnprintable, ansi.Strip(s))), " ")
+}
+
+// dropUnprintable drops what would reach the terminal as something other than
+// itself: control characters, and the format characters (category Cf) that
+// reorder a line, such as U+202E RIGHT-TO-LEFT OVERRIDE, or carry directional
+// state into whatever is printed next, such as an unterminated bidi isolate.
+// Whitespace is kept for sanitizeText to collapse, and so is U+200D ZERO WIDTH
+// JOINER, which holds an emoji sequence together rather than hiding anything.
+func dropUnprintable(r rune) rune {
+	if r == '\u200d' || unicode.IsSpace(r) {
+		return r
+	}
+	if unicode.IsControl(r) || unicode.Is(unicode.Cf, r) {
+		return -1
+	}
+	return r
+}
+
+// oneLineSummary sanitizes text and shortens it to fit a status line. The
+// limit counts runes, so truncation never splits one.
 func oneLineSummary(s string) string {
-	s = strings.Join(strings.Fields(s), " ")
-	if len(s) > 160 {
-		return s[:157] + "..."
+	s = sanitizeText(s)
+	if utf8.RuneCountInString(s) <= 160 {
+		return s
 	}
-	return s
+	return string([]rune(s)[:157]) + "..."
 }
