+		},
+		{
+			// A review that exits non-zero carries the sidecar's stderr as its
+			// error, colour codes and all.
+			name: "an errored review's sidecar output is stripped",
+			outcome: factory.Outcome{
+				Result: factory.ResultExhausted,
+				Rounds: 1,
+				Checks: []factory.Check{{
+					Name:   "bugs",
+					Kind:   factory.KindReview,
