+// fakePatchWriter records how WritePatch was called, including the state of
+// the context it was given.
+type fakePatchWriter struct {
+	err         error
+	called      bool
+	path        string
+	ctxErr      error
+	deadline    time.Time
+	hasDeadline bool
+}
+
+func (f *fakePatchWriter) WritePatch(ctx context.Context, path string) error {
+	f.called, f.path, f.ctxErr = true, path, ctx.Err()
+	f.deadline, f.hasDeadline = ctx.Deadline()
+	return f.err
+}
+
+// TestSaveFactoryPatchSurvivesACancelledRun pins the reason the patch is
+// written with a detached context: the work is saved after ^C too, which is
+// exactly when losing it would hurt most.
+func TestSaveFactoryPatchSurvivesACancelledRun(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	w := &fakePatchWriter{}
+	status, lines := recordStatus()
+
+	saveFactoryPatch(ctx, w, t.TempDir(), factory.Change{Stat: "1 file changed"}, status, discardStreams())
+
+	assert.Assert(t, w.called, "the patch was not written")
+	assert.NilError(t, w.ctxErr)
+	assert.Assert(t, w.hasDeadline, "the write has no deadline of its own")
+	assert.Assert(t, time.Until(w.deadline) <= 2*time.Minute, "deadline is %s away, want at most 2m", time.Until(w.deadline))
+	assert.Assert(t, time.Until(w.deadline) > time.Minute, "deadline is %s away, want about 2m", time.Until(w.deadline))
+	assert.Equal(t, len(*lines), 1)
+}
