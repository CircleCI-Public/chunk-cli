+func TestSaveFactoryPatchFailureWarns(t *testing.T) {
+	w := &fakePatchWriter{err: errors.New("sidecar gone")}
+	status, lines := recordStatus()
+	var stderr bytes.Buffer
+
+	saveFactoryPatch(context.Background(), w, t.TempDir(), factory.Change{Stat: "2 files changed"}, status, iostream.Streams{Out: io.Discard, Err: &stderr})
+
+	assert.DeepEqual(t, *lines, []statusLine{{Level: iostream.LevelWarn, Msg: "could not save the implementer's work: sidecar gone"}})
+	assert.Equal(t, stderr.String(), "")
+}
