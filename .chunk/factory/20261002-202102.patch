+func TestPrintActivity(t *testing.T) {
+	tests := []struct {
+		name      string
+		activity  factory.Activity
+		wantLines []statusLine
+	}{
+		{
+			// Text the implementer wrote carries no tool, and is not printed:
+			// the status line follows what it did, not what it said.
+			name:     "prose without a tool is not printed",
+			activity: factory.Activity{Detail: "I will start by reading the tests."},
+		},
+		{
+			name:      "a tool and its target are printed on one line",
+			activity:  factory.Activity{Tool: "Read", Detail: "internal/cmd/factory.go"},
+			wantLines: []statusLine{{Level: iostream.LevelInfo, Msg: "  Read internal/cmd/factory.go"}},
+		},
+		{
+			// Both halves come from claude's stream, so both are stripped.
+			name:      "escape sequences in the tool name and detail are stripped",
+			activity:  factory.Activity{Tool: "Ba\x1b[31msh", Detail: "task test\n  --race"},
+			wantLines: []statusLine{{Level: iostream.LevelInfo, Msg: "  Bash task test --race"}},
+		},
+		{
+			name:      "a long detail is shortened",
+			activity:  factory.Activity{Tool: "Bash", Detail: strings.Repeat("a", 200)},
+			wantLines: []statusLine{{Level: iostream.LevelInfo, Msg: "  Bash " + strings.Repeat("a", 157) + "..."}},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			status, lines := recordStatus()
+
+			printActivity(status, tt.activity)
+
+			assert.DeepEqual(t, *lines, tt.wantLines)
+		})
+	}
+}
