+// writePrompt writes a review prompt file, creating its directory.
+func writePrompt(t *testing.T, dir, name, body string) {
+	t.Helper()
+	assert.NilError(t, os.MkdirAll(dir, 0o755))
+	assert.NilError(t, os.WriteFile(filepath.Join(dir, name), []byte(body), 0o644))
+}
