+func TestSaveFactoryPatch(t *testing.T) {
+	workDir := t.TempDir()
+	w := &fakePatchWriter{}
+	status, lines := recordStatus()
+	var stderr bytes.Buffer
+
+	saveFactoryPatch(context.Background(), w, workDir, factory.Change{Stat: "2 files changed"}, status, iostream.Streams{Out: io.Discard, Err: &stderr})
+
+	assert.Equal(t, filepath.Dir(w.path), filepath.Join(workDir, ".chunk", "factory"))
+	assert.Assert(t, strings.HasSuffix(w.path, ".patch"), "patch path %q has the wrong suffix", w.path)
+	assert.DeepEqual(t, *lines, []statusLine{{Level: iostream.LevelDone, Msg: "Saved 2 files changed to " + w.path}})
+	assert.Equal(t, stderr.String(), "  Apply it with: git apply "+w.path+"\n")
+}
