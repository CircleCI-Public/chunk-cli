+func TestPrintCheck(t *testing.T) {
+	tests := []struct {
+		name      string
+		check     factory.Check
+		wantLines []statusLine
+	}{
+		{
+			name:      "passed",
+			check:     factory.Check{Name: "test", Status: factory.StatusPassed, Duration: 3 * time.Second},
+			wantLines: []statusLine{{Level: iostream.LevelDone, Msg: "  test passed in 3s"}},
+		},
+		{
+			name:      "failed",
+			check:     factory.Check{Name: "test", Status: factory.StatusFailed, Duration: 3 * time.Second},
+			wantLines: []statusLine{{Level: iostream.LevelError, Msg: "  test failed in 3s"}},
+		},
+		{
+			// The error quotes whatever the command printed before it died.
+			name:      "errored output is stripped",
+			check:     factory.Check{Name: "test", Status: factory.StatusErrored, Error: "\x1b[2Kexited 127:\nnot found"},
+			wantLines: []statusLine{{Level: iostream.LevelWarn, Msg: "  test could not run: exited 127: not found"}},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			status, lines := recordStatus()
+
+			printCheck(status, tt.check)
+
+			assert.DeepEqual(t, *lines, tt.wantLines)
+		})
+	}
+}
