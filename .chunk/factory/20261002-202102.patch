+func TestPrintReviewProgress(t *testing.T) {
+	tests := []struct {
+		name      string
+		event     review.ProgressEvent
+		wantLines []statusLine
+	}{
+		{
+			// A queued review has not reached a sidecar yet, so there is
+			// nothing to report about it.
+			name:  "queued is silent",
+			event: review.ProgressEvent{Prompt: "bugs", State: review.StateQueued},
+		},
+		{
+			name:      "running names the sidecar",
+			event:     review.ProgressEvent{Prompt: "bugs", SidecarID: "sc-1", State: review.StateRunning},
+			wantLines: []statusLine{{Level: iostream.LevelInfo, Msg: "  review bugs started on sc-1"}},
+		},
+		{
+			name:      "done reports how long it took",
+			event:     review.ProgressEvent{Prompt: "bugs", State: review.StateDone, Duration: 90 * time.Second},
+			wantLines: []statusLine{{Level: iostream.LevelInfo, Msg: "  review bugs finished in 1m30s"}},
+		},
+		{
+			name:      "failed output is stripped",
+			event:     review.ProgressEvent{Prompt: "bugs", State: review.StateFailed, Error: "\x1b[31mexited 1\x1b[0m\nno credential"},
+			wantLines: []statusLine{{Level: iostream.LevelWarn, Msg: "  review bugs could not run: exited 1 no credential"}},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			status, lines := recordStatus()
+
+			printReviewProgress(status, tt.event)
+
+			assert.DeepEqual(t, *lines, tt.wantLines)
+		})
+	}
+}
