{
  "commands": [
    {
      "name": "test",
      "run": "task test",
      "role": "gate",
      "timeout": 300,
      "remote": true
    },
    {
      "name": "acceptance-test",
      "run": "task acceptance-test",
      "role": "gate",
      "timeout": 300,
      "remote": true
    },
    {
      "name": "test-changed",
      "run": "task test -- {{CHANGED_PACKAGES}}",
      "timeout": 300
    },
    {
      "name": "lint",
      "run": "task lint",
      "role": "gate",
      "timeout": 300,
      "remote": true
    },
    {
      "name": "format",
      "run": "task fmt",
      "role": "autofix",
      "timeout": 30,
      "local": true
    }
  ],
  "vcs": {
    "org": "CircleCI-Public",
    "repo": "chunk-cli"
  },
  "validation": {
    "sidecarImage": "59aa3b19-8c7a-4a89-80e5-42661a341654"
  },
  "orgID": "f22b6566-597d-46d5-ba74-99ef5bb3d85c",
  "environment": {
    "stack": "go",
    "setup": [
      {
        "name": "runtime",
        "command": "curl -fsSL https://go.dev/dl/go1.26.10.linux-$(dpkg --print-architecture).tar.gz | sudo tar -C /usr/local -xzf -"
      },
      {
        "name": "system",
        "command": "sudo apt-get update && sudo apt-get install -y git --no-install-recommends && sudo rm -rf /var/lib/apt/lists/*"
      },
      {
        "name": "install",
        "command": "go mod download"
      },
      {
        "name": "warm-caches",
        "command": "task lint || true; go test -race -count=1 -run '^$' ./... || true"
      }
    ],
    "image": "cimg/go",
    "image_version": "1.26.10"
  }
}
