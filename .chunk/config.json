{
  "commands": [
    {
      "name": "test",
      "run": "task test",
      "role": "gate",
      "timeout": 300,
      "remote": true
    },
    {
      "name": "test-changed",
      "run": "task test -- {{CHANGED_PACKAGES}}",
      "timeout": 300
    },
    {
      "name": "lint",
      "run": "task lint",
      "role": "gate",
      "timeout": 60
    },
    {
      "name": "format",
      "run": "task fmt",
      "role": "autofix",
      "timeout": 30
    }
  ],
  "vcs": {
    "org": "CircleCI-Public",
    "repo": "chunk-cli"
  },
  "validation": {
    "sidecarImage": "3c128769-f6a7-4219-8240-a3562d91ed17"
  },
  "environment": {
    "stack": "go",
    "setup": [
      {
        "name": "runtime",
        "command": "curl -fsSL https://go.dev/dl/go1.26.2.linux-$(dpkg --print-architecture).tar.gz | sudo tar -C /usr/local -xzf -"
      },
      {
        "name": "system",
        "command": "sudo apt-get update && sudo apt-get install -y git --no-install-recommends && sudo rm -rf /var/lib/apt/lists/*"
      },
      {
        "name": "install",
        "command": "go mod download"
      }
    ],
    "image": "cimg/go",
    "image_version": "1.26.2"
  },
  "orgID": "f22b6566-597d-46d5-ba74-99ef5bb3d85c"
}
