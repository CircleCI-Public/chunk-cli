+func TestLoadProjectConfigRejectsAmbiguousCommands(t *testing.T) {
+	tests := []struct {
+		name string
+		json string
+		want string
+	}{
+		{"duplicate name", `{"commands":[{"name":"test","run":"a"},{"name":"lint","run":"b"},{"name":"test","run":"c"}]}`, `duplicate command name "test"`},
+		{"empty name", `{"commands":[{"name":"test","run":"a"},{"name":"","run":"b"}]}`, "command 2 has no name"},
+		{"blank name", `{"commands":[{"name":"  ","run":"a"}]}`, "command 1 has no name"},
+		{"negative timeout", `{"commands":[{"name":"lint","run":"a","timeout":-5}]}`, `command "lint" has a negative timeout`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			dir := t.TempDir()
+			writeProjectConfig(t, dir, tt.json)
+			_, err := LoadProjectConfig(dir)
+			assert.ErrorContains(t, err, tt.want)
+		})
+	}
+}
+
+func TestLoadProjectConfigAllowsDistinctCommandNames(t *testing.T) {
