+// validateCommands rejects commands that cannot be told apart or cannot run.
+// Commands are looked up by name, so a second command with a name already in
+// use would never be the one that runs, and nothing would say so.
+func validateCommands(commands []Command) error {
+	seen := make(map[string]bool, len(commands))
+	for i, command := range commands {
+		if strings.TrimSpace(command.Name) == "" {
+			return fmt.Errorf("command %d has no name", i+1)
+		}
+		if seen[command.Name] {
+			return fmt.Errorf("duplicate command name %q", command.Name)
+		}
+		seen[command.Name] = true
+		if command.Local && command.Remote {
+			return fmt.Errorf("command %q cannot be both local and remote", command.Name)
+		}
+		if command.Timeout < 0 {
+			return fmt.Errorf("command %q has a negative timeout (%d)", command.Name, command.Timeout)
+		}
+	}
+	return nil
+}
