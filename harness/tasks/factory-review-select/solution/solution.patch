new file mode 100644
index 00000000..06e7c127
--- /dev/null
+++ b/internal/factory/validate_test.go
@@ -0,0 +1,39 @@
+package factory
+
+import (
+	"errors"
+	"testing"
+
+	"gotest.tools/v3/assert"
+
+	"github.com/CircleCI-Public/chunk-cli/internal/review"
+)
+
+func TestSelectReviews(t *testing.T) {
+	prompts := []review.Prompt{{Name: "bugs"}, {Name: "security"}, {Name: "style"}}
+	names := func(ps []review.Prompt) []string {
+		out := []string{}
+		for _, p := range ps {
+			out = append(out, p.Name)
+		}
+		return out
+	}
+
+	all, err := SelectReviews(prompts, nil)
+	assert.NilError(t, err)
+	assert.DeepEqual(t, names(all), []string{"bugs", "security", "style"})
+
+	some, err := SelectReviews(prompts, []string{"style", "bugs", "style"})
+	assert.NilError(t, err)
+	assert.DeepEqual(t, names(some), []string{"bugs", "style"}) // in load order, each once
+
+	_, err = SelectReviews(prompts, []string{"bugs", "nope", "nada", "nope"})
+	var unknown *UnknownReviewsError
+	assert.Assert(t, errors.As(err, &unknown), "got %v", err)
+	assert.DeepEqual(t, unknown.Unknown, []string{"nope", "nada"})
+	assert.DeepEqual(t, unknown.Available, []string{"bugs", "security", "style"})
+	assert.Error(t, err, "unknown review(s) nope, nada; available: bugs, security, style")
+
+	_, err = SelectReviews(nil, []string{"bugs"})
+	assert.Error(t, err, "unknown review(s) bugs; there are no review prompts")
+}
