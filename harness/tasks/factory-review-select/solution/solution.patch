+// checkReviewNames refuses a --review naming no prompt in the reviews
+// directory, before anything starts; the daemon would refuse it too, but
+// without saying it was a bad argument.
+func checkReviewNames(prompts []review.Prompt, names []string) error {
+	_, err := factory.SelectReviews(prompts, names)
+	var unknown *factory.UnknownReviewsError
+	if !errors.As(err, &unknown) {
+		return err
+	}
+	suggestion := "There are no review prompts to choose from."
+	if len(unknown.Available) > 0 {
+		suggestion = "Available reviews: " + strings.Join(unknown.Available, ", ")
+	}
+	return newUserError(fmt.Sprintf("No review prompt named %s.", strings.Join(unknown.Unknown, ", "))).
+		withCode("command.invalid_args").
+		withSuggestion(suggestion).
+		withExitCode(ExitBadArgs).
+		withoutDetail()
+}
