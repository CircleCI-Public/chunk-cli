+// UnknownReviewsError is a selection of reviews naming prompts that are not
+// there. Available is every prompt's name, for saying what could be chosen.
+type UnknownReviewsError struct {
+	Unknown   []string
+	Available []string
+}
+
+func (e *UnknownReviewsError) Error() string {
+	available := "there are no review prompts"
+	if len(e.Available) > 0 {
+		available = "available: " + strings.Join(e.Available, ", ")
+	}
+	return fmt.Sprintf("unknown review(s) %s; %s", strings.Join(e.Unknown, ", "), available)
+}
+
+// SelectReviews keeps the prompts named in names, in the order loaded, each
+// once however often it is named. No names keeps every prompt. A name matching
+// no prompt is an *UnknownReviewsError.
+func SelectReviews(prompts []review.Prompt, names []string) ([]review.Prompt, error) {
+	if len(names) == 0 {
+		return prompts, nil
+	}
+	known := make(map[string]bool, len(prompts))
+	available := make([]string, 0, len(prompts))
+	for _, p := range prompts {
+		known[p.Name] = true
+		available = append(available, p.Name)
+	}
+	wanted := make(map[string]bool, len(names))
+	var unknown []string
+	for _, n := range names {
+		if wanted[n] {
+			continue
+		}
+		wanted[n] = true
+		if !known[n] {
+			unknown = append(unknown, n)
+		}
+	}
+	if len(unknown) > 0 {
+		return nil, &UnknownReviewsError{Unknown: unknown, Available: available}
+	}
+	selected := make([]review.Prompt, 0, len(wanted))
+	for _, p := range prompts {
+		if wanted[p.Name] {
+			selected = append(selected, p)
+		}
+	}
+	return selected, nil
+}
