+import { useEffect, useState } from 'react';
 import Layout from './Components/Layout';
 import Header from './Components/Header';
 import Container from './Components/Container';
@@ -7,12 +8,56 @@ import type { Post } from './types';
 
 const posts: Post[] = postsData;
 
+const readQuery = () => new URLSearchParams(window.location.search).get('q') ?? '';
+
+const writeQuery = (query: string) => {
+  const url = new URL(window.location.href);
+  if (query) {
+    url.searchParams.set('q', query);
+  } else {
+    url.searchParams.delete('q');
+  }
+  window.history.replaceState(window.history.state, '', url);
+};
+
 function App() {
+  const [query, setQuery] = useState(readQuery);
+
+  useEffect(() => {
+    const onPopState = () => setQuery(readQuery());
+    window.addEventListener('popstate', onPopState);
+    return () => window.removeEventListener('popstate', onPopState);
+  }, []);
+
+  const needle = query.trim().toLowerCase();
+  const matches = posts.filter(
+    (post) =>
+      post.title.toLowerCase().includes(needle) || post.author.toLowerCase().includes(needle),
+  );
+
   return (
     <Layout>
       <Header title="Baby Hippo Gram" />
       <Container>
-        <Card cards={posts} />
+        <div className="mb-8">
+          <label className="mb-1 block text-sm text-zinc-500" htmlFor="search">
+            Search hippos
+          </label>
+          <input
+            id="search"
+            type="search"
+            className="w-full border border-zinc-300 px-3 py-2"
+            value={query}
+            onChange={(e) => {
+              setQuery(e.target.value);
+              writeQuery(e.target.value);
+            }}
+          />
+        </div>
+        <p aria-live="polite" className="text-zinc-500">
+          {matches.length === 0 ? 'No hippos found.' : ''}
+        </p>
+        <Card cards={matches} />
       </Container>
     </Layout>
   );
