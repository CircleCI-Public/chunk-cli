+// failedSessions keeps the sessions that failed, in the order listed.
+func failedSessions(sessions []watchd.Session) []watchd.Session {
+	failed := []watchd.Session{}
+	for _, s := range sessions {
+		if s.State == watchd.SessionFailed {
+			failed = append(failed, s)
+		}
+	}
+	return failed
+}
