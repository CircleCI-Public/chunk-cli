+// TestSessionListFailedFiltersBothOutputs leaves the daemon with one finished
+// and one failed session and checks --failed keeps only the failed one.
+func TestSessionListFailedFiltersBothOutputs(t *testing.T) {
+	isolateConfig(t)
+	t.Setenv(config.EnvXDGDataHome, t.TempDir())
+	cfg := fakeSessionConfig("fine")
+	var failing atomic.Bool
+	stream := cfg.Stream
+	cfg.Stream = func(ctx context.Context, e *sidecar.PoolEntry, id string, on circleci.OutputFn) (int, error) {
+		if failing.Load() {
+			on(circleci.StreamStdout, []byte("this is not a claude result"))
+			return 0, nil
+		}
+		return stream(ctx, e, id, on)
+	}
+	startSessionDaemon(t, cfg)
+
+	start := func() string {
+		out, err := runSessionCmd(t, "start", "--detach", "--json", "--project", sessionProject(t))
+		assert.NilError(t, err)
+		var started map[string]string
+		assert.NilError(t, json.Unmarshal([]byte(out), &started))
+		for deadline := time.Now().Add(30 * time.Second); ; time.Sleep(50 * time.Millisecond) {
+			d, err := watchd.FetchSession(started["id"])
+			assert.NilError(t, err)
+			if d.State.Finished() {
+				return started["id"]
+			}
+			assert.Assert(t, time.Now().Before(deadline), "session did not finish")
+		}
+	}
+	done := start()
+	failing.Store(true)
+	failed := start()
+
+	out, err := runSessionCmd(t, "list", "--failed")
+	assert.NilError(t, err)
+	assert.Assert(t, strings.Contains(out, failed), out)
+	assert.Assert(t, !strings.Contains(out, done), out)
+	assert.Equal(t, strings.Count(out, "\n"), 1, out)
+
+	out, err = runSessionCmd(t, "list", "--failed", "--json")
+	assert.NilError(t, err)
+	var listed []watchd.Session
+	assert.NilError(t, json.Unmarshal([]byte(out), &listed))
+	assert.Equal(t, len(listed), 1)
+	assert.Equal(t, listed[0].ID, failed)
+	assert.Equal(t, listed[0].State, watchd.SessionFailed)
+
+	out, err = runSessionCmd(t, "list")
+	assert.NilError(t, err)
+	assert.Assert(t, strings.Contains(out, done) && strings.Contains(out, failed), out)
+}
