package cmd

// Hidden acceptance tests for the session-list-failed eval task. The harness
// copies this file in after the agent has finished, so the agent never sees it.
// Every assertion traces to a sentence of the task's instruction.md; anything
// the instruction leaves open is not checked.

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"sync/atomic"
	"testing"
	"time"

	"gotest.tools/v3/assert"

	"github.com/CircleCI-Public/chunk-cli/internal/circleci"
	"github.com/CircleCI-Public/chunk-cli/internal/config"
	"github.com/CircleCI-Public/chunk-cli/internal/review"
	"github.com/CircleCI-Public/chunk-cli/internal/sidecar"
	"github.com/CircleCI-Public/chunk-cli/internal/watchd"
)

// hiddenEvalSessions runs a real daemon with a fake backend and leaves it with
// a finished session, a failed one and a cancelled one, in different projects.
// Reviews succeed in mode 0, return garbage (failing the session) in mode 1 and
// block until cancelled in mode 2.
func hiddenEvalSessions(t *testing.T) (doneID, failedID, cancelledID string) {
	t.Helper()
	isolateConfig(t)
	t.Setenv(config.EnvXDGDataHome, t.TempDir())

	var mode atomic.Int32
	var next atomic.Int32
	structured := map[string]any{"review": "fine", "findings": []any{}}
	text, _ := json.Marshal(structured)
	good, _ := json.Marshal(map[string]any{
		"type": "result", "subtype": "success", "is_error": false,
		"result": string(text), "structured_output": structured,
	})
	cfg := watchd.ReviewConfig{
		Credential: review.Credential{EnvVar: config.EnvAnthropicAPIKey, Value: "sk-test"},
		NewPool: func(_ context.Context, spec watchd.ReviewPoolSpec) (*watchd.ReviewPool, error) {
			free := make(chan *sidecar.PoolEntry, spec.Size)
			for i := range spec.Size {
				free <- &sidecar.PoolEntry{ID: fmt.Sprintf("sc-%d", i+1), RepoPath: "/work"}
			}
			return &watchd.ReviewPool{
				Acquire:   func(context.Context) (*sidecar.PoolEntry, error) { return <-free, nil },
				Release:   func(e *sidecar.PoolEntry) { free <- e },
				WaitReady: func(context.Context) error { return nil },
				Close:     func(context.Context) {},
			}, nil
		},
		Submit: func(context.Context, *sidecar.PoolEntry, string, map[string]string) (string, error) {
			return fmt.Sprintf("cmd-%d", next.Add(1)), nil
		},
		Stream: func(ctx context.Context, _ *sidecar.PoolEntry, _ string, on circleci.OutputFn) (int, error) {
			switch mode.Load() {
			case 1:
				on(circleci.StreamStdout, []byte("this is not a claude result"))
			case 2:
				<-ctx.Done()
				return 0, ctx.Err()
			default:
				on(circleci.StreamStdout, good)
			}
			return 0, nil
		},
	}

	dir, err := os.MkdirTemp("", "wd")
	assert.NilError(t, err)
	t.Cleanup(func() { _ = os.RemoveAll(dir) })
	t.Setenv("CHUNK_WATCHD_DIR", dir)
	ctx, cancel := context.WithCancel(context.Background())
	errCh := make(chan error, 1)
	go func() { errCh <- watchd.RunDaemon(ctx, nil, "", nil, nil, watchd.WithReview(cfg)) }()
	t.Cleanup(func() {
		cancel()
		select {
		case <-errCh:
		case <-time.After(5 * time.Second):
			t.Error("daemon did not shut down")
		}
	})
	deadline := time.Now().Add(5 * time.Second)
	for !watchd.IsDaemonRunning() {
		if time.Now().After(deadline) {
			t.Fatal("daemon did not become reachable")
		}
		time.Sleep(20 * time.Millisecond)
	}

	doneID = hiddenEvalStart(t, hiddenEvalProject(t))
	assert.Equal(t, hiddenEvalWait(t, doneID), watchd.SessionDone, "precondition: the first session finishes")
	mode.Store(1)
	failedID = hiddenEvalStart(t, hiddenEvalProject(t))
	assert.Equal(t, hiddenEvalWait(t, failedID), watchd.SessionFailed, "precondition: the second session fails")
	mode.Store(2)
	cancelledID = hiddenEvalStart(t, hiddenEvalProject(t))
	assert.NilError(t, watchd.CancelSession(cancelledID))
	assert.Equal(t, hiddenEvalWait(t, cancelledID), watchd.SessionCancelled, "precondition: the third session is cancelled")
	return doneID, failedID, cancelledID
}

func hiddenEvalProject(t *testing.T) string {
	t.Helper()
	dir := t.TempDir()
	run := func(args ...string) {
		c := exec.Command("git", args...)
		c.Dir = dir
		c.Env = append(os.Environ(), "GIT_AUTHOR_NAME=T", "GIT_AUTHOR_EMAIL=t@t", "GIT_COMMITTER_NAME=T", "GIT_COMMITTER_EMAIL=t@t")
		out, err := c.CombinedOutput()
		assert.NilError(t, err, string(out))
	}
	run("init", "-b", "main")
	run("remote", "add", "origin", "https://github.com/acme/widgets.git")
	prompts := filepath.Join(dir, ".chunk", "reviews")
	assert.NilError(t, os.MkdirAll(prompts, 0o755))
	assert.NilError(t, os.WriteFile(filepath.Join(prompts, "bugs.md"), []byte("find bugs"), 0o644))
	run("add", ".")
	run("commit", "-m", "init")
	return dir
}

func hiddenEvalRun(t *testing.T, args ...string) (string, error) {
	t.Helper()
	cmd := newSessionCmd()
	var out, errOut bytes.Buffer
	cmd.SetOut(&out)
	cmd.SetErr(&errOut)
	cmd.SetArgs(args)
	cmd.SetContext(t.Context())
	err := cmd.Execute()
	return out.String(), err
}

func hiddenEvalStart(t *testing.T, project string) string {
	t.Helper()
	out, err := hiddenEvalRun(t, "start", "--detach", "--json", "--project", project)
	assert.NilError(t, err)
	var started map[string]string
	assert.NilError(t, json.Unmarshal([]byte(out), &started))
	assert.Assert(t, started["id"] != "")
	return started["id"]
}

func hiddenEvalWait(t *testing.T, id string) watchd.SessionState {
	t.Helper()
	deadline := time.Now().Add(30 * time.Second)
	for {
		detail, err := watchd.FetchSession(id)
		assert.NilError(t, err)
		if detail.State.Finished() {
			return detail.State
		}
		if time.Now().After(deadline) {
			t.Fatalf("session %s did not finish: %s", id, detail.State)
		}
		time.Sleep(50 * time.Millisecond)
	}
}

type hiddenEvalListed struct {
	ID          string            `json:"id"`
	State       string            `json:"state"`
	ProjectRoot string            `json:"project_root"`
	Rounds      []json.RawMessage `json:"rounds"`
}

func hiddenEvalListJSON(t *testing.T, args ...string) []hiddenEvalListed {
	t.Helper()
	out, err := hiddenEvalRun(t, append([]string{"list", "--json"}, args...)...)
	assert.NilError(t, err)
	var listed []hiddenEvalListed
	assert.NilError(t, json.Unmarshal([]byte(out), &listed), out)
	return listed
}

// hiddenEvalLine is the text line `chunk session list` prints for a session
// before the change.
func hiddenEvalLine(s hiddenEvalListed) string {
	return fmt.Sprintf("%s  %-9s  %s  %d round(s)", s.ID, s.State, s.ProjectRoot, len(s.Rounds))
}

func hiddenEvalIDs(listed []hiddenEvalListed) []string {
	ids := make([]string, 0, len(listed))
	for _, s := range listed {
		ids = append(ids, s.ID)
	}
	return ids
}

func TestHiddenEvalSessionList(t *testing.T) {
	doneID, failedID, cancelledID := hiddenEvalSessions(t)
	all := hiddenEvalListJSON(t)

	// "Keep the command's current output unchanged when the flag is absent."
	t.Run("without the flag JSON lists every session", func(t *testing.T) {
		ids := hiddenEvalIDs(all)
		assert.Equal(t, len(all), 3, "%v", ids)
		for _, id := range []string{doneID, failedID, cancelledID} {
			assert.Assert(t, strings.Contains(strings.Join(ids, " "), id), "%v", ids)
		}
	})
	t.Run("without the flag text output is unchanged", func(t *testing.T) {
		out, err := hiddenEvalRun(t, "list")
		assert.NilError(t, err)
		var want strings.Builder
		for _, s := range all {
			want.WriteString(hiddenEvalLine(s) + "\n")
		}
		assert.Equal(t, out, want.String())
	})

	// "When set, show only sessions whose state is failed; apply the same
	// filtering to text and JSON output."
	t.Run("with the flag JSON lists only failed sessions", func(t *testing.T) {
		listed := hiddenEvalListJSON(t, "--failed")
		assert.Equal(t, len(listed), 1, "%v", hiddenEvalIDs(listed))
		assert.Equal(t, listed[0].ID, failedID)
		assert.Equal(t, listed[0].State, string(watchd.SessionFailed))
	})
	t.Run("with the flag text lists only failed sessions", func(t *testing.T) {
		out, err := hiddenEvalRun(t, "list", "--failed")
		assert.NilError(t, err)
		assert.Assert(t, !strings.Contains(out, doneID), out)
		assert.Assert(t, !strings.Contains(out, cancelledID), out)
		var failed hiddenEvalListed
		for _, s := range all {
			if s.ID == failedID {
				failed = s
			}
		}
		assert.Equal(t, out, hiddenEvalLine(failed)+"\n")
	})
}
