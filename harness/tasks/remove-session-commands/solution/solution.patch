diff --git a/internal/cmd/factory_daemon_test.go b/internal/cmd/factory_daemon_test.go
index 2cf7ad32..49ee7fe9 100644
--- a/internal/cmd/factory_daemon_test.go
+++ b/internal/cmd/factory_daemon_test.go
@@ -7,6 +7,7 @@ import (
 	"errors"
 	"fmt"
 	"os"
+	"os/exec"
 	"path/filepath"
 	"strings"
 	"testing"
@@ -227,3 +228,39 @@ func TestFactoryRejectsAttemptsBelowOne(t *testing.T) {
 	assert.Equal(t, ue.UserMessage(), "--attempts must be at least 1.")
 	assert.Equal(t, ue.UserExitCode(), ExitBadArgs)
 }
+
+// A run works on this machine's files, so a remote daemon is refused.
+func TestFactoryRefusesARemoteDaemon(t *testing.T) {
+	factoryProject(t)
+	t.Setenv("CHUNK_WATCHD_REMOTE_ADDR", "127.0.0.1:1")
+
+	_, _, err := runFactoryCmd(t, "add a --verbose flag")
+	var ue *userError
+	assert.Assert(t, errors.As(err, &ue), "got %v", err)
+	assert.Equal(t, ue.UserExitCode(), ExitBadArgs)
+}
+
+func TestFactoryOutsideAGitRepositoryIsRefused(t *testing.T) {
+	isolateConfig(t)
+	t.Setenv(config.EnvXDGDataHome, t.TempDir())
+	t.Chdir(t.TempDir())
+
+	_, _, err := runFactoryCmd(t, "add a --verbose flag")
+	assert.ErrorContains(t, err, "not inside a git repository")
+}
+
+func TestFactoryWithoutAnOriginRemoteFailsBeforeAnySandboxWork(t *testing.T) {
+	project := factoryProject(t)
+	// No daemon is running: the check must come before the daemon is needed.
+	c := exec.Command("git", "remote", "remove", "origin")
+	c.Dir = project
+	out, err := c.CombinedOutput()
+	assert.NilError(t, err, string(out))
+
+	_, _, err = runFactoryCmd(t, "add a --verbose flag")
+	var ue *userError
+	assert.Assert(t, errors.As(err, &ue), "got %v", err)
+	assert.Assert(t, strings.Contains(ue.UserMessage(), "origin"))
+	assert.Assert(t, strings.Contains(ue.Suggestion(), "git remote add origin"))
+	assert.Equal(t, ue.UserExitCode(), ExitBadArgs)
+}
