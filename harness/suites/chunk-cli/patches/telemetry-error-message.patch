+	outcome := "success"
+	if err != nil {
+		outcome = "failure"
+	}
+
+	props := map[string]any{
+		"command":     cmd.CommandPath(),
+		"flags":       strings.Join(flags, ","),
+		"outcome":     outcome,
+		"duration_ms": duration.Milliseconds(),
