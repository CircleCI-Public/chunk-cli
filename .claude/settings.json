{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Generated by chunk init.",
  "permissions": {
    "allow": [
      "Bash(chunk:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "chunk conflicts --hook",
            "timeout": 5,
            "statusMessage": "Running chunk conflicts before commit"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "cd ${CLAUDE_PROJECT_DIR:-.} && chunk validate",
            "timeout": 600,
            "statusMessage": "Running chunk validate before commit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "chunk validate",
            "timeout": 420,
            "statusMessage": "Running chunk validate"
          }
        ]
      }
    ]
  }
}
