{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Generated by chunk init.",
  "permissions": {
    "allow": [
      "Bash(chunk:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR:-.} && task fmt",
            "timeout": 30,
            "statusMessage": "Running task fmt before commit"
          },
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR:-.} && chunk validate lint",
            "timeout": 60,
            "statusMessage": "Running chunk validate lint before commit"
          },
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR:-.} && chunk validate test",
            "timeout": 300,
            "statusMessage": "Running chunk validate test before commit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "chunk validate",
            "timeout": 420,
            "statusMessage": "Running chunk validate"
          }
        ]
      }
    ]
  }
}
