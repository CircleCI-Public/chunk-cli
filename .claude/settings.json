{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Generated by smelt init.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "smelt conflicts --hook",
            "if": "Bash(git commit*)",
            "statusMessage": "Running smelt conflicts before commit",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "cd ${CLAUDE_PROJECT_DIR:-.} \u0026\u0026 smelt validate",
            "if": "Bash(git commit*)",
            "statusMessage": "Running smelt validate before commit",
            "timeout": 600,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "smelt validate",
            "statusMessage": "Running smelt validate",
            "timeout": 600,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(smelt:*)"
    ]
  }
}
