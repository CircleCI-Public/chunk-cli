{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "chunk validate",
            "if": "Bash(git commit*)",
            "statusMessage": "Running chunk validate if this is a commit",
            "timeout": 600,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "chunk validate",
            "statusMessage": "Running chunk validate",
            "timeout": 600,
            "type": "command"
          }
        ]
      }
    ]
  }
}
